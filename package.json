{
  "name": "english-learning-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "vocab:gen": "npx tsx scripts/vocab-generator/cli.ts",
    "vocab:seeds": "npx tsx scripts/vocab-generator/extract-seed-words.ts",
    "vocab:clean-cache": "npx tsx scripts/vocab-generator/cli.ts --clean-cache",
    "vocab:reset": "npx tsx scripts/vocab-generator/cli.ts --reset-corpus",
    "vocab:compile": "npx tsx scripts/vocab-generator/cli.ts --compile",
    "eval:validate-dataset": "npx tsx evals/scripts/validate-dataset.ts",
    "eval:layers-1-2": "npx tsx evals/scripts/run-layer1-2-evals.ts",
    "eval:layer-3": "npx tsx evals/scripts/run-layer3-eval.ts",
    "eval:regression": "npx tsx evals/scripts/run-regression-eval.ts",
    "eval:regression:fast": "npx tsx evals/scripts/run-regression-eval.ts --fast",
    "eval:regression:full": "npx tsx evals/scripts/run-regression-eval.ts --full",
    "eval:generator:live": "npx tsx evals/scripts/run-live-generator-eval.ts --full --compare",
    "eval:generator:live:fast": "npx tsx evals/scripts/run-live-generator-eval.ts --fast --compare",
    "eval:audit-corpus": "npx tsx evals/scripts/run-corpus-audit.ts",
    "eval:audit-batch": "npx tsx evals/scripts/run-corpus-audit.ts --file",
    "eval:writing:validate": "npx tsx evals/scripts/validate-writing-datasets.ts",
    "eval:writing:layers-1-2": "npx tsx evals/scripts/run-writing-layer1-2-evals.ts",
    "eval:writing:layer-3": "npx tsx evals/scripts/run-writing-layer3-eval.ts",
    "eval:writing:regression": "npx tsx evals/scripts/run-writing-regression-eval.ts",
    "eval:writing:regression:fast": "npx tsx evals/scripts/run-writing-regression-eval.ts --fast",
    "eval:writing:regression:full": "npx tsx evals/scripts/run-writing-regression-eval.ts --full",
    "eval:writing:live": "npx tsx evals/scripts/run-writing-live-eval.ts --full",
    "eval:writing:live:fast": "npx tsx evals/scripts/run-writing-live-eval.ts --fast"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/charis-sil": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@google/genai": "2.24.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-notification": "2.5.0",
    "@tauri-apps/plugin-opener": "2.6.0",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "2.4.0",
    "@tauri-apps/plugin-sql": "2.5.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-stronghold": "2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "dayjs": "1.11.23",
    "diff": "9.0.0",
    "kokoro-js": "^1.2.1",
    "kysely": "0.29.6",
    "kysely-dialect-tauri": "2.0.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/diff": "8.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}