{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "English Learning Assistant",
  "version": "1.0.0",
  "identifier": "com.ela.learningassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "English Learning Assistant (ELA)",
        "width": 1280,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ela.db"]
    }
  }
}
